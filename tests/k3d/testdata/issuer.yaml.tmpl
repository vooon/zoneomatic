apiVersion: v1
kind: Secret
metadata:
  name: zoneomatic-tsig
  namespace: cert-manager
type: Opaque
stringData:
  secret: "{{ .TSIGSecret }}"
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: zoneomatic-pebble
spec:
  acme:
    server: https://pebble.{{ .Namespace }}.svc.cluster.local:14000/dir
    # Pebble serves a self-signed test certificate.
    skipTLSVerify: true
    privateKeySecretRef:
      name: zoneomatic-pebble-account
    solvers:
      - dns01:
          rfc2136:
            nameserver: "{{ .RFC2136Server }}"
            tsigKeyName: "{{ .TSIGKeyName }}"
            tsigAlgorithm: HMACSHA256
            tsigSecretSecretRef:
              name: zoneomatic-tsig
              key: secret
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: zoneomatic-test
  namespace: {{ .Namespace }}
spec:
  secretName: zoneomatic-test-tls
  # Apex and wildcard share _acme-challenge.{{ .ZoneName }}, so both tokens
  # must coexist in the zone while the challenges are validated.
  dnsNames:
    - {{ .ZoneName }}
    - "*.{{ .ZoneName }}"
  issuerRef:
    kind: ClusterIssuer
    name: zoneomatic-pebble
