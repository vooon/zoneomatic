apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: zoneomatic
  namespace: {{ .Namespace }}
data:
  htpasswd: |
    {{ .HTPasswd }}
  tsig.conf: |
    key "{{ .TSIGKeyName }}" {
      algorithm hmac-sha256;
      secret "{{ .TSIGSecret }}";
    };
  at.example.com.zone: |
{{ .Zone | indent 4 }}
  Corefile: |
    {{ .ZoneName }}:1053 {
      file /zones/{{ .ZoneName }}.zone {{ .ZoneName }} {
        reload 1s
      }
      log
      errors
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: zoneomatic
  namespace: {{ .Namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: zoneomatic
  template:
    metadata:
      labels:
        app: zoneomatic
    spec:
      securityContext:
        runAsUser: 65532
        runAsGroup: 65532
        runAsNonRoot: true
      initContainers:
        - name: seed
          image: {{ .BusyboxImage }}
          command: ["cp", "/seed/{{ .ZoneName }}.zone", "/zones/{{ .ZoneName }}.zone"]
          volumeMounts:
            - { name: config, mountPath: /seed }
            - { name: zones, mountPath: /zones }
      containers:
        - name: zoneomatic
          image: {{ .ZoneomaticImage }}
          args:
            - --listen=0.0.0.0:9999
            - --htpasswd=/etc/zm/htpasswd
            - --zone=/zones/{{ .ZoneName }}.zone
            - --rfc2136-acme-listen=0.0.0.0:5353
            - --rfc2136-acme-tsig-file=/etc/zm/tsig.conf
          volumeMounts:
            - { name: config, mountPath: /etc/zm }
            - { name: zones, mountPath: /zones }
        # Serves the zone file zoneomatic writes, like the authoritative
        # server in a real deployment. cert-manager and Pebble query it.
        - name: coredns
          image: {{ .CoreDNSImage }}
          args: ["-conf", "/etc/zm/Corefile"]
          volumeMounts:
            - { name: config, mountPath: /etc/zm }
            - { name: zones, mountPath: /zones }
        # Lets the test read the zone file (the other images have no shell).
        - name: tools
          image: {{ .BusyboxImage }}
          command: ["sleep", "infinity"]
          volumeMounts:
            - { name: zones, mountPath: /zones }
      volumes:
        - name: config
          configMap:
            name: zoneomatic
        - name: zones
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: zoneomatic
  namespace: {{ .Namespace }}
spec:
  selector:
    app: zoneomatic
  ports:
    - { name: dns-udp, port: 53, targetPort: 1053, protocol: UDP }
    - { name: dns-tcp, port: 53, targetPort: 1053, protocol: TCP }
    - { name: rfc2136-udp, port: 5353, targetPort: 5353, protocol: UDP }
    - { name: rfc2136-tcp, port: 5353, targetPort: 5353, protocol: TCP }
